# Native host development: expose PostgreSQL only through the local Compose override.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=repick
PGUSER=repick_app
PGPASSWORD=replace-with-the-app-password
HOST=127.0.0.1
PORT=3000
# db:migrate uses PG* too: run it with PGUSER=repick_migrator and its password.

# Server-only AI credentials. Empty key disables generation; stored reports remain readable.
LLM_BASE_URL=https://llm.shh.name/v1
LLM_API_KEY=
LLM_WEEKLY_MODEL=gpt-5.6-luna
LLM_MONTHLY_MODEL=gpt-6.1-sol
LLM_FOOD_MODEL=gpt-5.6-luna
LLM_TIMEOUT_MS=45000
REPORT_REGISTRATIONS_PER_IP_HOUR=20
REPORTS_PER_INSTALLATION_DAY=12
REPORTS_PER_IP_DAY=30
REPORTS_GLOBAL_PER_DAY=100
FOOD_ANALYSES_PER_INSTALLATION_DAY=20
FOOD_ANALYSES_PER_IP_DAY=50
FOOD_ANALYSES_GLOBAL_PER_DAY=200
